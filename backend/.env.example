PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/rent-ease
JWT_SECRET=your_jwt_secret_here
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# CORS_ORIGINS is the exact allowlist and takes precedence over CLIENT_URL/FRONTEND_URL.
# For LAN testing, add the frontend origin currently being used, e.g.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://<current-pc-ip>:5173
# For production, configure the exact HTTPS frontend origin(s) in CORS_ORIGINS
# and set FRONTEND_URL to the production frontend URL for password-reset links.
# Optional: set UPLOAD_DIR to a persistent local volume; cloud storage can return
# absolute media URLs through the same API response without frontend changes.

# Email Delivery Configuration (Optional in development - falls back to console logging if unconfigured)
# Option A: Resend API (Recommended)
# RESEND_API_KEY=re_your_api_key_here

# Option B: Brevo API
# BREVO_API_KEY=xkeysib-your_api_key_here

# Option C: SMTP Relay
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM="Rent Ease" <no-reply@rentease.com>
